# Template only: make a copy named .env and add your own key there.
# Do not overwrite an existing .env or share it with your submission.
# Start with: uv run --env-file .env python main.py serve --port 8000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 1 simulates an outage without sending any Gemini requests. Restart after changing.
BEDA_MODEL_OFFLINE=0
